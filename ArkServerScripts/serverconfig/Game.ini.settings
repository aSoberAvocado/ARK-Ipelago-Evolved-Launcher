# Recommended Game.ini settings for an Archipelago ARK run.
# apply_server_config.bat reads the key=value lines below and writes them into your real
# Game.ini (under the matching [section]), updating keys in place and adding missing ones -
# it does NOT overwrite unrelated settings you already have.
#
# Lines starting with # or ; are comments (ignored). Edit the values to taste, then run
# apply_server_config.bat. Section headers in [brackets] tell the tool where each key goes.

[/script/shootergame.shootergamemode]
# how fast babies grow (higher = faster maturation)
BabyMatureSpeedMultiplier=30.0
# incubation / egg hatch speed (higher = faster)
EggHatchSpeedMultiplier=30.0
# imprint cuddle interval (lower = need to imprint less often = easier)
BabyCuddleIntervalMultiplier=0.01
# how soon dinos can re-mate (lower = breed sooner)
MatingIntervalMultiplier=0.05

BabyImprintingStatScaleMultiplier=3.000000

BabyCuddleLoseImprintQualitySpeedMultiplier=0.010000

PerLevelStatsMultiplier_DinoTamed_Add[1]=1.800000

PerLevelStatsMultiplier_DinoTamed_Add[3]=2.000000

PerLevelStatsMultiplier_DinoTamed_Add[7]=1.800000

PerLevelStatsMultiplier_DinoTamed_Add[9]=2.000000

PerLevelStatsMultiplier_Player[0]=1.500000

PerLevelStatsMultiplier_Player[1]=1.500000

PerLevelStatsMultiplier_Player[7]=1.500000

PerLevelStatsMultiplier_Player[9]=1.800000

PerLevelStatsMultiplier_Player[10]=1.500000

CropGrowthSpeedMultiplier=6.000000

CustomRecipeEffectivenessMultiplier=3.000000

CustomRecipeSkillMultiplier=20.000000

DinoHarvestingDamageMultiplier=3.200000

KillXPMultiplier=2.000000

SpecialXPMultiplier=2.000000

bAllowCustomRecipes=True

SupplyCrateLootQualityMultiplier=5.000000

FishingLootQualityMultiplier=5.000000

CraftingSkillBonusMultiplier=50.000000

bAllowFlyerSpeedLeveling=True